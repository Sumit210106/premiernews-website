<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Allow WordPress Admin, REST API, & Core Assets to pass directly to WordPress
  RewriteCond %{REQUEST_URI} ^/(wp-admin|wp-json|wp-content|wp-includes|wp-login\.php|xmlrpc\.php) [NC,OR]
  RewriteCond %{REQUEST_FILENAME} \.php$
  RewriteRule ^ - [L]

  # 2. Serve existing static files & assets (CSS, JS, images)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 3. Map clean Next.js URLs to pre-rendered HTML files (e.g. /about-us -> /about-us.html)
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.*)$ /$1.html [L]

  # 4. Fallback for unmatched routes to 404 page
  RewriteCond %{DOCUMENT_ROOT}/404.html -f
  RewriteRule ^(.*)$ /404.html [L]
</IfModule>
